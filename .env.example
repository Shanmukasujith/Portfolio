# Copy this file to .env for LOCAL use. On Vercel, set these as Environment Variables instead.

# Supabase: Project -> Connect -> "Transaction pooler" connection string (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Needed for the admin endpoints (add/delete projects, read messages).
# Use a long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=

PORT=3000

# Optional: force database SSL on/off. Default: on for Supabase and in production.
# DATABASE_SSL=false
